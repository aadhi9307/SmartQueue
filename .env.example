# Copy to .env (local) or set in your hosting dashboard. Never commit real values.

# development | production  (production enforces a strong JWT_SECRET)
APP_ENV=development

# REQUIRED in production: 32+ random chars.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# SQLite by default. For production use hosted Postgres, e.g. postgresql://user:pass@host:5432/smartqueue
# (SQLite on Vercel is ephemeral - data is lost between deployments/cold starts.)
DATABASE_URL=sqlite:///./smartqueue.db

# First administrator (created on startup only if no admin exists). Password >= 12 chars.
SMARTQUEUE_ADMIN_USERNAME=admin
SMARTQUEUE_ADMIN_EMAIL=admin@example.com
SMARTQUEUE_ADMIN_PASSWORD=

# Comma-separated browser origins allowed to call the API directly (not needed when the SPA is served by the same host)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# IANA timezone used for "today" statistics, e.g. Asia/Kolkata
QUEUE_TIMEZONE=UTC

# Public site URL used in SMS tracking links, e.g. https://queue.example.com
PUBLIC_APP_URL=

# Let customers upgrade their own ticket to VIP (true/false)
ALLOW_CUSTOMER_VIP=true

# Optional SMS (Twilio). Without these the app records "NOT_CONFIGURED" and sends nothing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
